    {
      "id": "rule1",
      "type": "text",
      "x": 60,
      "y": 485,
      "width": 900,
      "height": 25,
      "text": "Regla 1 — si difieren en cantidad de dimensiones, se rellena con 1 a la izquierda: (3,) -> (1, 3)",
      "originalText": "Regla 1 — si difieren en cantidad de dimensiones, se rellena con 1 a la izquierda: (3,) -> (1, 3)",
